{
    # Enable FrankenPHP
    frankenphp

    # Enable Mercure hub
    order mercure after encode
}

:80 {
    root * /app/webroot
    encode zstd gzip

    # Mercure with CORS
    route /.well-known/mercure {
        header Access-Control-Allow-Origin "https://sandbox.dereuromark.de"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Last-Event-ID, Authorization"
        header Access-Control-Allow-Credentials "true"

        @options method OPTIONS
        handle @options {
            respond 204
        }

        handle {
            # Issuer and resource identifier must match the app's Mercure jwt.issuer and audience.
            mercure {
                resource_identifier https://sandbox.dereuromark.de/.well-known/mercure
                issuer https://sandbox.dereuromark.de {
                    publisher {
                        jwt {env.MERCURE_PUBLISHER_JWT_KEY} HS256
                    }
                    subscriber {
                        jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} HS256
                    }
                }
                anonymous
                subscriptions
            }
        }
    }

    # PHP handling via FrankenPHP in worker mode
    php_server {
        worker /app/webroot/worker.php 12
    }
}
